---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { url } from '../lib/url';
import { indexable } from '../lib/env';

interface Props {
  title?: string;
  description?: string;
  /* 검색에서 빼야 하는 페이지에만 켠다. */
  noindex?: boolean;
}

const { title, description = site.description, noindex = false } = Astro.props;
const full = title ? `${title} · ${site.name}` : `${site.name} — ${site.taglineKo}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
/* 카카오톡·인스타 공유에서 확실히 뜨도록 OG 는 jpg 1200×630 으로 둔다. */
const ogImage = new URL(url('/og.jpg'), Astro.site).href;
---

<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(noindex || !indexable) && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/png" sizes="32x32" href={url('/icon-32.png')} />
    <link rel="apple-touch-icon" href={url('/icon-180.png')} />
    <link rel="preload" as="font" type="font/woff2" crossorigin
      href={url('/fonts/nbg-400.woff2')} />
    <link rel="preload" as="font" type="font/woff2" crossorigin
      href={url('/fonts/nbg-700.woff2')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
  </head>
  <body>
    <a class="skip" href="#main">본문으로</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <style>
      .skip {
        position: absolute; left: -9999px;
        background: var(--wine-700); color: #fff;
        padding: 0.6rem 1rem; z-index: 20;
      }
      .skip:focus { left: 0.5rem; top: 0.5rem; }
    </style>
  </body>
</html>
