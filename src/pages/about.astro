---
import Base from '../layouts/Base.astro';
import { about } from '../data/site';
import { url } from '../lib/url';
import { rich, lines } from '../lib/text';

const { believe, why } = about;
---

<Base title="About"
      description="YOUTH란 나이가 아니라 일상을 대하는 태도입니다. 서울유스클럽은 신뢰를 기반으로 연결과 성장을 만들어가는 네트워크입니다.">
  <section class="band band-wine">
    <div class="shell">
      <p class="kicker">About</p>
      <h1 set:html={lines(about.heading)} />
    </div>
  </section>

  <section class="band">
    <div class="shell prose">
      <h3>{believe.kicker}</h3>
      <h2>{believe.heading}</h2>
      {believe.paras.map((t) => <p set:html={rich(t)} />)}
      <blockquote>{believe.quote}</blockquote>
      {believe.after.map((t) => <p set:html={rich(t)} />)}
    </div>
  </section>

  <section class="band band-paper">
    <div class="shell prose">
      <h3>{why.kicker}</h3>
      <h2>{why.heading}</h2>
      {why.paras.map((t) => <p set:html={rich(t)} />)}

      <h2>{why.listHeading}</h2>
      <ul>{why.list.map((t) => <li>{t}</li>)}</ul>

      <p class="close" set:html={lines(why.close)} />
      <p class="mt"><a href={url('/join')}>가입 신청 &rarr;</a></p>
    </div>
  </section>
</Base>

<style>
  h1 { font-size: clamp(1.9rem, 6vw, 3.1rem); }
  .close {
    font-weight: 700;
    font-size: 1.06rem;
    border-top: 1px solid var(--line-2);
    padding-top: 1.6rem;
    margin-top: 2.4rem;
  }
  .mt { margin-top: 2rem; font-weight: 700; }
</style>
