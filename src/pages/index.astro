---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import EventCard from '../components/EventCard.astro';
import Grid from '../components/Grid.astro';
import { site, home, programs } from '../data/site';
import { url } from '../lib/url';
import { lines, fill } from '../lib/text';

const { belief, record, programsIntro, chefs, membership } = home;

const all = (await getCollection('events'))
  .map((e) => e.data)
  .filter((e) => !e.draft && e.date)
  .sort((a, b) => (a.date! < b.date! ? 1 : -1));

const recent = all.slice(0, 6);
const first = all[all.length - 1];
const since = first.date!.slice(0, 4);
const sinceMonth = Number(first.date!.slice(5, 7));
const places = new Set(all.map((e) => e.place).filter(Boolean)).size;
const recordLede = fill(record.lede, { since, month: sinceMonth });
---

<Base>
  <!-- 1. 무엇을 믿는 곳인지 한 줄로 -->
  <section class="band band-wine hero">
    <div class="shell">
      <p class="kicker">{site.taglineSub}</p>
      <h1>{site.tagline}</h1>
      <p class="hero-ko">{site.taglineKo}</p>
      <p class="lede">{site.description}</p>
      <p class="cta">
        <a class="btn" href={url('/join')}>가입 신청</a>
        <a class="ghost" href={url('/about')}>우리가 믿는 것 &rarr;</a>
      </p>
    </div>
  </section>

  <!-- 2. 왜 다른가 -->
  <section class="band">
    <div class="shell">
      <p class="kicker">{belief.kicker}</p>
      <h2 class="claim" set:html={lines(belief.claim)} />
      <p class="lede">{belief.lede}</p>

      <ul class="pillars">
        {belief.pillars.map((p) => (
          <li>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </li>
        ))}
      </ul>

      <p class="more"><a href={url('/about')}>About 더 읽기 &rarr;</a></p>
    </div>
  </section>

  <!-- 3. 말보다 기록 -->
  <section class="band band-paper">
    <div class="shell">
      <p class="kicker">{record.kicker}</p>
      <h2>{record.heading}</h2>
      <p class="lede">{recordLede}</p>

      <dl class="stats">
        <div><dt>개최한 모임</dt><dd>{all.length}<span>회</span></dd></div>
        <div><dt>다녀온 장소</dt><dd>{places}<span>곳</span></dd></div>
        <div><dt>운영 프로그램</dt><dd>{programs.length}<span>종</span></dd></div>
        <div><dt>시작</dt><dd>{since}<span>년</span></dd></div>
      </dl>

      <ul class="venues">
        {record.venues.map((v) => <li>{v}</li>)}
      </ul>

      <p class="kicker mt">Recent</p>
      <Grid>
        {recent.map((e, i) => <EventCard {...e} eager={i < 3} />)}
      </Grid>
      <p class="more"><a href={url('/events')}>전체 기록 {all.length}건 보기 &rarr;</a></p>
    </div>
  </section>

  <!-- 4. 어떻게 만나는가 -->
  <section class="band">
    <div class="shell">
      <p class="kicker">{programsIntro.kicker}</p>
      <h2>{programsIntro.heading}</h2>
      <p class="lede">{programsIntro.lede}</p>
      <ul class="progs">
        {programs.map((p) => (
          <li>
            <div class="ph">
              <h3>{p.label}</h3>
              <p class="pk">{p.kicker}</p>
            </div>
            <p class="pb">{p.blurb}</p>
          </li>
        ))}
      </ul>
      <p class="more"><a href={url('/programs')}>프로그램 자세히 보기 &rarr;</a></p>
    </div>
  </section>

  <!-- 5. 누구를 만났는가 — 이름이 곧 증거다 -->
  <section class="band band-paper">
    <div class="shell">
      <p class="kicker">{chefs.kicker}</p>
      <h2>{chefs.heading}</h2>
      <p class="lede">{chefs.lede}</p>
      <ul class="chefs">
        {chefs.items.map((c) => (
          <li><b>{c.name}</b><span>{c.at}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 6. 들어오는 길 -->
  <section class="band band-wine">
    <div class="shell">
      <p class="kicker">{membership.kicker}</p>
      <h2 class="join-h">{membership.heading}</h2>
      <p class="lede">{membership.lede}</p>
      <ol class="steps">
        {membership.steps.map((s, i) => (
          <li>
            <span class="n">{String(i + 1).padStart(2, '0')}</span>
            <b>{s.step}</b>
            <span class="t">{s.text}</span>
          </li>
        ))}
      </ol>
      <p class="cta"><a class="btn" href={url('/join')}>가입 신청하기</a></p>
    </div>
  </section>
</Base>

<style>
  /* ---------- 1. hero ---------- */

  .hero { padding-block: clamp(4.5rem, 13vw, 8.5rem); }
  .hero h1 { font-size: clamp(2.4rem, 8vw, 4.4rem); font-weight: 700; margin: 0; }
  .hero-ko {
    margin: 1.1rem 0 0;
    font-size: clamp(1rem, 2.6vw, 1.3rem);
    color: #D8A79A;
    letter-spacing: 0.02em;
  }
  .cta {
    margin: 2.3rem 0 0;
    display: flex; flex-wrap: wrap; gap: 0.9rem 1.6rem; align-items: center;
  }
  .ghost { font-size: 0.92rem; font-weight: 700; text-decoration: none; }
  .ghost:hover { text-decoration: underline; }

  /* ---------- 2. 믿는 것 ---------- */

  .claim { font-size: clamp(1.5rem, 4.2vw, 2.3rem); }

  .pillars {
    list-style: none; margin: 3rem 0 0; padding: 0;
    display: grid; gap: 2rem;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
  }
  .pillars h3 {
    font-size: 1.02rem;
    padding-top: 0.9rem;
    border-top: 2px solid var(--wine-700);
  }
  .pillars p { margin: 0.7rem 0 0; font-size: 0.9rem; color: var(--text-2); }

  /* ---------- 3. 기록 ---------- */

  .stats {
    display: grid; gap: 1px;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    margin: 2.6rem 0 0;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: 2px;
  }
  .stats > div { background: var(--paper); padding: 1.25rem 1.2rem; }
  .stats dt {
    font-size: 0.7rem; font-weight: 700; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--text-3);
  }
  .stats dd {
    margin: 0.35rem 0 0;
    font-size: 2rem; font-weight: 700; line-height: 1;
    letter-spacing: -0.04em; color: var(--wine-700);
    font-variant-numeric: tabular-nums;
  }
  .stats dd span {
    font-size: 0.86rem; font-weight: 400; letter-spacing: 0;
    color: var(--text-2); margin-left: 0.2rem;
  }

  .venues {
    list-style: none; margin: 1.6rem 0 0; padding: 0;
    display: flex; flex-wrap: wrap; gap: 0.5rem;
  }
  .venues li {
    font-size: 0.8rem; font-weight: 700; letter-spacing: 0.02em;
    color: var(--wine-700);
    border: 1px solid var(--line-2); border-radius: 2px;
    padding: 0.32rem 0.7rem;
    background: var(--paper);
  }

  .mt { margin-top: 3.4rem; }
  .more { margin: 1.7rem 0 0; font-size: 0.92rem; font-weight: 700; }

  /* ---------- 4. 프로그램 ---------- */

  .progs { list-style: none; margin: 2.4rem 0 0; padding: 0; border-top: 1px solid var(--line); }
  .progs li {
    display: grid; gap: 0.4rem 2.4rem;
    grid-template-columns: 1fr;
    padding: 1.3rem 0;
    border-bottom: 1px solid var(--line);
  }
  @media (min-width: 46rem) {
    .progs li { grid-template-columns: 15rem 1fr; align-items: baseline; }
  }
  .ph { display: flex; flex-wrap: wrap; gap: 0.15rem 0.7rem; align-items: baseline; }
  .progs h3 { margin: 0; font-size: 1.06rem; }
  .pk {
    margin: 0; font-size: 0.64rem; font-weight: 700; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--wine-600); white-space: nowrap;
  }
  .pb { margin: 0; font-size: 0.9rem; color: var(--text-2); line-height: 1.62; }

  /* ---------- 5. 셰프 ---------- */

  .chefs {
    list-style: none; margin: 2.6rem 0 0; padding: 0;
    display: grid; gap: 1px;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    background: var(--line); border: 1px solid var(--line); border-radius: 2px;
  }
  .chefs li {
    background: var(--paper-2);
    padding: 1.3rem 1.2rem;
    display: flex; flex-direction: column; gap: 0.25rem;
  }
  .chefs b {
    font-size: 1.3rem; font-weight: 700; letter-spacing: -0.03em;
    color: var(--wine-700);
  }
  .chefs span { font-size: 0.8rem; color: var(--text-3); }

  /* ---------- 6. 가입 ---------- */

  .join-h { font-size: clamp(1.4rem, 3.8vw, 2.1rem); }

  .steps {
    list-style: none; margin: 2.6rem 0 0; padding: 0;
    display: grid; gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
  }
  .steps li { display: grid; gap: 0.3rem; }
  .steps .n {
    font-size: 0.72rem; font-weight: 700; letter-spacing: 0.16em;
    color: #C98A7C; font-variant-numeric: tabular-nums;
  }
  .steps b { font-size: 1.02rem; }
  .steps .t { font-size: 0.86rem; color: #E3CEC8; }
</style>
