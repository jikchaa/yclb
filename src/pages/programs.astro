---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { programs } from '../data/site';
import { url } from '../lib/url';

const all = (await getCollection('events')).map((e) => e.data).filter((e) => !e.draft && e.date);

const rows = programs.map((p) => {
  const mine = all
    .filter((e) => e.program === p.id)
    .sort((a, b) => (a.date! < b.date! ? 1 : -1));
  return { ...p, count: mine.length, recent: mine.slice(0, 4) };
});
---

<Base title="Programs"
      description="YOUTH Networking, 유스미식회, 프리미엄 와인, Insight & Host Session, Gathering — 서울유스클럽이 운영하는 다섯 갈래의 프로그램입니다.">
  <section class="band band-wine">
    <div class="shell">
      <p class="kicker">Programs</p>
      <h1>처음 만나는 자리와<br />오래 남는 자리를 나눕니다.</h1>
      <p class="lede">
        네트워킹 한 종류로는 깊이가 생기지 않습니다. 다섯 갈래를 따로 운영하는 이유입니다.
      </p>
    </div>
  </section>

  {rows.map((p, i) => (
    <section class={`band ${i % 2 ? 'band-paper' : ''}`}>
      <div class="shell row">
        <div class="fig">
          <img src={url(p.poster)} alt={`${p.label} 포스터`}
               width="1280" height="720" loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />
        </div>
        <div class="txt">
          <p class="kicker">{p.kicker}</p>
          <h2>{p.label}</h2>
          <p class="blurb">{p.blurb}</p>
          <p class="count">지금까지 <b>{p.count}</b>회 열렸습니다.</p>
          {p.recent.length > 0 && (
            <ul class="recent">
              {p.recent.map((e) => (
                <li><span class="d">{e.date!.slice(0, 7).replace('-', '. ')}</span>{e.title}</li>
              ))}
            </ul>
          )}
        </div>
      </div>
    </section>
  ))}

  <section class="band">
    <div class="shell">
      <p class="more"><a href={url('/events')}>전체 기록 보기 &rarr;</a></p>
    </div>
  </section>
</Base>

<style>
  h1 { font-size: clamp(1.8rem, 5.5vw, 2.9rem); }

  .row { display: grid; gap: 2rem; grid-template-columns: 1fr; align-items: start; }
  @media (min-width: 54rem) {
    .row { grid-template-columns: 1.05fr 1fr; gap: 3rem; }
  }
  .fig img {
    width: 100%; aspect-ratio: 16 / 9; object-fit: cover;
    border: 1px solid var(--line); border-radius: 2px; background: var(--wine-800);
  }
  .txt h2 { font-size: clamp(1.4rem, 3.6vw, 1.9rem); }
  .blurb { margin: 1rem 0 0; color: var(--text-2); max-width: 34rem; }
  .count { margin: 1.4rem 0 0; font-size: 0.9rem; color: var(--text-2); }
  .count b { color: var(--wine-700); font-variant-numeric: tabular-nums; }

  .recent { list-style: none; margin: 1.1rem 0 0; padding: 0; }
  .recent li {
    font-size: 0.86rem; color: var(--text-2);
    padding: 0.45rem 0; border-top: 1px solid var(--line);
  }
  .d {
    display: inline-block; min-width: 4.6rem;
    color: var(--text-3); font-variant-numeric: tabular-nums;
  }
  .more { margin: 0; font-weight: 700; }
</style>
